# Copy this file to .env and edit. Every value is optional - the app runs with the defaults.
# Most of the values marked (UI) can also be changed later on the dashboard's Settings page;
# values saved there are stored in the database and override this file.

# Application
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database - SQLite for dev, PostgreSQL for prod
DATABASE_URL=sqlite+aiosqlite:///./ppe_detection.db
# DATABASE_URL=postgresql+asyncpg://ppe:ppe@db:5432/ppe_detection

# Model
MODEL_PATH=Model/ppe.pt
DETECTION_CONFIDENCE=0.5      # (UI) minimum score for people / other objects
PPE_ITEM_CONFIDENCE=0.3       # (UI) lower bar for Hardhat and Safety Vest detections

# Person tracking - stable worker IDs, per-worker violations
ENABLE_TRACKING=true
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_AGE=30
TRACK_MIN_HITS=3
PPE_SMOOTHING_WINDOW=15

# Pose estimation - keypoints locate head/torso for PPE assignment
# (weights are auto-downloaded by ultralytics on first run; set false to run lighter on CPU)
ENABLE_POSE=true
POSE_MODEL_PATH=yolo11n-pose.pt
POSE_CONFIDENCE=0.5

# Violation rules (seconds)
VIOLATION_PERSIST_SECONDS=3   # (UI) a worker must stay non-compliant this long before an incident
ALERT_COOLDOWN_SECONDS=30     # (UI) minimum gap before the same worker+violation type is recorded again

# Screenshots are saved to FRAMES_DIR/<date>/camera_<id>/
FRAMES_DIR=violation_frames

# Email notifications - OPTIONAL. Leave as-is to run without email.
EMAIL_ENABLED=true            # (UI) master switch
EMAIL_NOTIFY_HELMET=true      # (UI)
EMAIL_NOTIFY_VEST=true        # (UI)
EMAIL_NOTIFY_COMBINED=true    # (UI)
SMTP_HOST=smtp.gmail.com      # (UI)
SMTP_PORT=587                 # (UI)
SENDER_EMAIL=your_email@gmail.com        # (UI)
RECEIVER_EMAIL=receiver_email@example.com  # (UI)
EMAIL_PASSWORD=your_app_password         # (UI, write-only) Gmail needs an App Password

# Optional: generic HTTP webhook (JSON POST per violation)
WEBHOOK_URL=
